<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-8">
  <div class="max-w-4xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center justify-center w-8 h-8 bg-blue-600 rounded-full mb-4" style="width: 32px; height: 32px;">
        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 16px; height: 16px; max-width: 16px; max-height: 16px;">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
        </svg>
      </div>
      <h1 class="text-4xl font-bold text-gray-900 mb-3">AI Assistant</h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">Ask questions about your scraped content and get intelligent, contextual answers powered by AI.</p>
    </div>

    <!-- Question Form -->
    <div class="bg-white rounded-2xl shadow-xl p-8 mb-8 border border-gray-100">
      <h2 class="text-xl font-semibold text-gray-900 mb-6">Ask Your Question</h2>
      <%= form_with url: answer_website_path, method: :post, class: "space-y-6", id: "question-form", data: { controller: "chat-form", action: "submit->chat-form#submit" } do |f| %>
        <%= hidden_field_tag :timestamp, Time.current.to_i %>
        <div>
          <label for="question" class="block text-sm font-semibold text-gray-700 mb-3">Your Question</label>
          <%= f.text_field :question, 
              id: "question-input",
              class: "w-full px-6 py-4 text-lg border-2 border-gray-200 rounded-xl focus:ring-4 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200",
              placeholder: "e.g., What types of products do you sell?",
              data: { chat_form_target: "input" } %>
        </div>
        <%= f.submit "Get AI Answer", 
            class: "w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-bold py-4 px-8 rounded-xl text-lg transition-all duration-200 transform hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none shadow-lg",
            data: { chat_form_target: "submit" },
            onclick: "console.log('Submit button clicked - Question:', document.getElementById('question-input').value)" %>
      <% end %>
      

    </div>

    <!-- Loading Indicator -->
    <div id="loading-indicator" class="hidden bg-white rounded-2xl shadow-xl p-8 mb-8 border border-gray-100" data-chat-form-target="loading">
      <div class="flex items-center justify-center space-x-4">
        <div class="animate-spin rounded-full h-10 w-10 border-4 border-blue-600 border-t-transparent"></div>
        <div>
          <p class="text-lg font-semibold text-gray-900">Generating AI response...</p>
          <p class="text-sm text-gray-500">This may take a few seconds</p>
        </div>
      </div>
    </div>

    <!-- AI Answer -->
    <div id="ai-response" data-chat-form-target="response">
      <% if @answer[:question].present? %>
        <%= render partial: "ai_answer", locals: { answer: @answer } %>
      <% end %>
    </div>

    <!-- Navigation -->
    <div class="flex justify-center space-x-6 mt-12">
      <%= link_to websites_path, 
          class: "inline-flex items-center px-6 py-3 bg-gray-800 hover:bg-gray-900 text-white font-semibold rounded-xl transition-all duration-200 transform hover:scale-105 shadow-lg border-2 border-gray-700" do %>
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Websites
      <% end %>
      
      <%= link_to new_website_path, 
          class: "inline-flex items-center px-6 py-3 bg-green-700 hover:bg-green-800 text-white font-semibold rounded-xl transition-all duration-200 transform hover:scale-105 shadow-lg border-2 border-green-600" do %>
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        Submit New URL
      <% end %>
    </div>
  </div>
</div>

 