
<div class="bg-white rounded-2xl shadow-xl p-8 mb-8 border border-gray-100">
  <div class="flex items-center mb-6">
    <div class="w-8 h-8 bg-gradient-to-r from-blue-500 to-blue-600 rounded-full flex items-center justify-center mr-4 shadow-lg" style="width: 32px; height: 32px;">
      <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 16px; height: 16px; max-width: 16px; max-height: 16px;">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
      </svg>
    </div>
    <div>
      <h2 class="text-2xl font-bold text-gray-900">AI Answer</h2>
      <p class="text-sm text-gray-500">Generated based on your question</p>
      <% if answer[:timestamp] %>
        <p class="text-xs text-gray-400 mt-1">Response ID: <%= answer[:timestamp] %></p>
      <% end %>
    </div>
  </div>
  
  <div class="bg-gradient-to-r from-gray-50 to-blue-50 rounded-xl p-8 mb-8 border border-gray-200">
    <div class="prose prose-lg max-w-none">
      <% if answer[:success] %>
        <div class="text-gray-800 leading-relaxed text-lg">
          <%= markdown(answer[:answer]) %>
        </div>
      <% else %>
        <div class="text-red-600 leading-relaxed text-lg">
          <%= markdown(answer[:answer]) %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Sources -->
  <% if answer[:chunks].any? %>
    <div class="border-t border-gray-200 pt-8">
      <h3 class="text-xl font-bold text-gray-900 mb-6 flex items-center">
        <svg class="w-4 h-4 mr-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 16px; height: 16px; max-width: 16px; max-height: 16px;">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        Sources (<%= answer[:chunks].count %>)
      </h3>
      <div class="space-y-6">
        <% answer[:chunks].each_with_index do |chunk, index| %>
          <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm hover:shadow-md transition-shadow duration-200">
            <div class="flex items-start">
              <span class="bg-gradient-to-r from-blue-500 to-blue-600 text-white text-sm font-bold px-4 py-2 rounded-full mr-5 mt-1 flex-shrink-0 shadow-sm">
                Source <%= index + 1 %>
              </span>
              <div class="flex-1 min-w-0">
                <p class="text-base text-gray-700 leading-relaxed mb-3 font-medium"><%= chunk.content %></p>
                <div class="flex items-center space-x-4 text-sm">
                  <% if chunk.section.present? %>
                    <span class="text-gray-500 font-medium">
                      <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 16px; height: 16px; max-width: 16px; max-height: 16px;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                      </svg>
                      <%= chunk.section %>
                    </span>
                  <% end %>
                  <% if chunk.website&.url.present? %>
                    <span class="text-gray-400">
                      <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 16px; height: 16px; max-width: 16px; max-height: 16px;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9v-9m0-9v9"></path>
                      </svg>
                      <%= chunk.website.url %>
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div> 